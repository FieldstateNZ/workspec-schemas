{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.workspec.io/v1alpha1/decision.schema.json",
  "title": "WorkSpec Decision (v1alpha1)",
  "description": "A repository-native record of an architectural or technical decision.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "workspec.io/v1alpha1",
      "description": "Artifact API version discriminant."
    },
    "kind": {
      "type": "string",
      "const": "Decision",
      "description": "Artifact kind discriminant."
    },
    "metadata": {
      "type": "object",
      "description": "Common artifact identity.",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable filename slug. Optional because repository tooling can derive it from `.workspec/decisions/<slug>.yaml`."
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "description": "The decision record.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short human-readable title for the decision."
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "deprecated",
            "superseded"
          ],
          "description": "Lifecycle state of the decision record."
        },
        "created": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the decision record was created, in quoted ISO 8601 full-date form (`YYYY-MM-DD`). Quote the value in YAML so parsers do not coerce it to a date object."
        },
        "decided": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the decision was accepted or rejected, in quoted ISO 8601 full-date form (`YYYY-MM-DD`). Quote the value in YAML so parsers do not coerce it to a date object."
        },
        "deciders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "People or groups accountable for the decision."
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "description": "The circumstances, problem, and constraints that made a decision necessary."
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "description": "The proposed or recorded decision."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this decision was selected."
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Expected consequences of the decision."
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Name of an alternative that was considered."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Why the alternative was not selected."
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "description": "Other approaches considered while making the decision."
        },
        "supersedes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Bare slug of the earlier decision this record supersedes."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cardinality": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "enum": [
                      "0..1",
                      "1",
                      "1..1",
                      "0..*",
                      "1..*"
                    ],
                    "description": "Multiplicity at the source end."
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "0..1",
                      "1",
                      "1..1",
                      "0..*",
                      "1..*"
                    ],
                    "description": "Multiplicity at the target end."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional human-readable relationship label."
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            },
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "description": "The link type, or `cardinality` for the optional relationship multiplicity."
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(~/|@workspace/)",
              "description": "A WorkSpec-tree (`~/`) or published-workspace (`@workspace/`) path reference."
            },
            "if": {
              "required": [
                "cardinality"
              ]
            },
            "then": {
              "minProperties": 2,
              "maxProperties": 2
            },
            "else": {
              "minProperties": 1,
              "maxProperties": 1
            }
          },
          "description": "Traversable relationships to WorkSpec artifacts: exactly one `{<linkType>: <pathRef>}` pair per entry, plus optional cardinality. Path refs must start with `~/` or `@workspace/`."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "description": "Type of supporting material, such as `issue`, `evidence`, `rfc`, or `spike`."
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "description": "A repository-relative path, absolute URL, or opaque external reference."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Optional human-readable label for the reference."
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          },
          "description": "Supporting repository files, issues, evidence, RFCs, and external resources that are not traversable WorkSpec artifact relationships."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Free-form labels used to organise and discover decisions."
        }
      },
      "required": [
        "title",
        "status",
        "context",
        "decision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
